# Quorum v2 — environment variables
#
# Copy to `.env.local` (Vercel app) and populate. Never commit real values.
#
# BYOK is sacred: the ONLY secret a user provides is their LLM API key, and it
# is stored encrypted in Redis — the operator needs NO LLM key.

# --- Infra (operator-only, set in Vercel project settings) -----------------
# Upstash Redis URL. Drives state + the encrypted LLM-key store + pub/sub.
REDIS_URL=
# (Some Upstash plans expose this instead of a raw REDIS_URL.)
UPSTASH_REDIS_REST_URL=
# Per-deployment AES-256-GCM key used to encrypt user LLM keys at rest.
ENCRYPTION_KEY=
# Inngest signing key (print from `npx inngest-cli` / Inngest dashboard).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Tavily API key for web search + extract.
TAVILY_API_KEY=

# --- Auth (Phase 4, optional) -------------------------------------------------
# When all three are set, owner-namespaced routes require a signed session cookie
# and derive the user id from GitHub OAuth. When unset, Quorum runs as a single
# local operator (no sign-in) — suitable for a private, single-user deploy.
# HMAC secret used to sign (not encrypt) the session + OAuth state cookies.
SESSION_SECRET=
# GitHub OAuth app credentials (register at github.com/settings/developers).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional override; defaults to <origin>/api/auth/callback. Must match the
# callback URL registered on the GitHub OAuth app exactly.
GITHUB_REDIRECT_URI=

# --- Modal agent (Phase 2) ---------------------------------------------------
# HTTPS URL of the deployed Modal web endpoint (printed by `modal deploy`).
# Example: https://<org>--quorum-agent-run.modal.run
MODAL_AGENT_URL=
