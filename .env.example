# Quorum v2 — environment variables
#
# Copy to `.env.local` (Vercel app) and populate. Never commit real values.
#
# BYOK is sacred: the ONLY secret a user provides is their LLM API key, and it
# is stored encrypted in Redis — the operator needs NO LLM key.

# --- Infra (operator-only, set in Vercel project settings) -----------------
# Upstash Redis URL. Drives state + the encrypted LLM-key store + pub/sub.
REDIS_URL=
# (Some Upstash plans expose this instead of a raw REDIS_URL.)
UPSTASH_REDIS_REST_URL=
# Per-deployment AES-256-GCM key used to encrypt user LLM keys at rest.
ENCRYPTION_KEY=
# Inngest signing key (print from `npx inngest-cli` / Inngest dashboard).
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Tavily API key for web search + extract.
TAVILY_API_KEY=

# --- Modal agent (Phase 2) ---------------------------------------------------
# HTTPS URL of the deployed Modal web endpoint (printed by `modal deploy`).
# Example: https://<org>--quorum-agent-run.modal.run
MODAL_AGENT_URL=
